# --- Secrets: never commit ---------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.jks
gitlab-secrets.json
gitlab.rb.local

# --- PKI: only the public CA certificate is tracked -------------------------
pki/*.crt
pki/*.csr
pki/*.srl
pki/*.cnf.tmp
!pki/ca.crt

# --- State and backups: live on the server, never in git --------------------
backups/
*.tar
*.tar.gz
*.sql
*.dump

# --- Local tooling / editor / OS --------------------------------------------
CLAUDE.local.md
.claude/
.vscode/
.idea/
*.swp
*~
.DS_Store
