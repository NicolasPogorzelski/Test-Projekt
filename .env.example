# Copy to .env in the respective stack directory and fill in real values.
# Generate secrets with:  openssl rand -base64 32
# Never commit a .env file (see .gitignore).
# Variable names below are placeholders until each stack is built; they are then
# aligned with the names the respective image expects (e.g. XWiki: DB_USER, DB_PASSWORD).

# ---- common ----------------------------------------------------------------
DOMAIN=lab.test
TZ=Europe/Berlin

# ---- proxy (Caddy) ---------------------------------------------------------
# no secrets; certificates are mounted from /srv/proxy/certs

# ---- lldap (services/lldap/.env) --------------------------------------------
# Base DN and public URL are not secrets and live in compose.yaml.
LLDAP_JWT_SECRET=CHANGE_ME              # signs UI sessions; openssl rand -base64 32
LLDAP_KEY_SEED=CHANGE_ME                # encrypts stored keys; openssl rand -base64 32 - NEVER change after first start, part of every backup
LLDAP_LDAP_USER_PASS=CHANGE_ME          # password of the built-in admin "admin" (web UI + LDAP bind); long, from the password manager

# ---- gitlab ----------------------------------------------------------------
# No root password here: GitLab generates it on first start and writes it to
# /srv/gitlab/config/initial_root_password (deleted after 24 h) - see services/gitlab/README.md.
# Nothing is needed until the LDAP block is added (phase 6):
GITLAB_LDAP_BIND_PASSWORD=CHANGE_ME     # password of svc-gitlab in lldap

# ---- xwiki (services/xwiki/.env) ---------------------------------------------
XWIKI_DB_PASSWORD=CHANGE_ME             # openssl rand -hex 24 - hex only, it lands in a JDBC URL
# LDAP bind password for svc-xwiki is entered in the wiki's admin UI, not here.

# ---- openproject (services/openproject/.env) ---------------------------------
# Hex only (openssl rand -hex): the DB password is embedded in DATABASE_URL, where "/" or "+" would break the URL.
OPENPROJECT_DB_PASSWORD=CHANGE_ME       # openssl rand -hex 24
OPENPROJECT_SECRET_KEY_BASE=CHANGE_ME   # openssl rand -hex 64 - signs sessions/tokens, part of every backup
# LDAP bind password for svc-openproject is entered in the admin UI, not here.
