# Copy to .env in the respective stack directory and fill in real values.
# Generate secrets with:  openssl rand -base64 32
# Never commit a .env file (see .gitignore).
# Variable names below are placeholders until each stack is built; they are then
# aligned with the names the respective image expects (e.g. XWiki: DB_USER, DB_PASSWORD).

# ---- common ----------------------------------------------------------------
DOMAIN=lab.test
TZ=Europe/Berlin

# ---- proxy (Caddy) ---------------------------------------------------------
# no secrets; certificates are mounted from /srv/proxy/certs

# ---- lldap -----------------------------------------------------------------
LLDAP_JWT_SECRET=CHANGE_ME
LLDAP_KEY_SEED=CHANGE_ME
LLDAP_LDAP_BASE_DN=dc=lab,dc=test
LLDAP_LDAP_USER_PASS=CHANGE_ME          # password of the lldap admin user

# ---- gitlab ----------------------------------------------------------------
# No root password here: GitLab generates it on first start and writes it to
# /srv/gitlab/config/initial_root_password (deleted after 24 h) - see services/gitlab/README.md.
# Nothing is needed until the LDAP block is added (phase 6):
GITLAB_LDAP_BIND_PASSWORD=CHANGE_ME     # password of svc-gitlab in lldap

# ---- xwiki -----------------------------------------------------------------
XWIKI_DB_PASSWORD=CHANGE_ME
XWIKI_LDAP_BIND_PASSWORD=CHANGE_ME      # password of svc-xwiki in lldap

# ---- openproject -----------------------------------------------------------
OPENPROJECT_DB_PASSWORD=CHANGE_ME
OPENPROJECT_SECRET_KEY_BASE=CHANGE_ME   # openssl rand -hex 64
OPENPROJECT_LDAP_BIND_PASSWORD=CHANGE_ME  # password of svc-openproject in lldap
